{
 "说明": "E6 术语检查只放不会误报的词（P.06 \"不要叫\"列里有不少常用词，如\"图\"\"执行\"\"接口\"，在别的语境里是正确用法，不能整表机械检查）。新增一条前先用 --refs 或全文搜索确认不会误报。",
 "rules": [
  {
   "pattern": "子系统|嵌套系统|子流程",
   "show": "子系统 / 嵌套系统 / 子流程",
   "use": "子图"
  },
  {
   "pattern": "运行抽屉",
   "use": "监控页"
  },
  {
   "pattern": "检查器|Inspector",
   "show": "检查器",
   "use": "属性页"
  },
  {
   "pattern": "挂起",
   "use": "等待中 / 等待审批"
  },
  {
   "pattern": "封装为子图",
   "use": "打包为子图"
  },
  {
   "pattern": "(?<!引导)气泡",
   "show": "气泡",
   "use": "浮动回复"
  },
  {
   "pattern": "工具栏",
   "use": "停靠栏"
  },
  {
   "pattern": "侧边栏",
   "use": "左侧栏 / 右侧栏"
  },
  {
   "pattern": "输入栏|聊天框",
   "show": "输入栏 / 聊天框",
   "use": "对话框"
  },
  {
   "pattern": "鹰眼",
   "use": "小地图"
  },
  {
   "pattern": "推理强度",
   "use": "思考强度"
  },
  {
   "pattern": "挡位",
   "use": "强度（思考强度）；授权用\"档位\""
  },
  {
   "pattern": "参数转端口|转为端口",
   "show": "参数转端口",
   "use": "参数接线"
  },
  {
   "pattern": "设置中心",
   "use": "中心窗口"
  },
  {
   "pattern": "同名接口|变量接口|节点上的接口|悬停接口",
   "show": "接口（指节点端口）",
   "use": "端口"
  },
  {
   "pattern": "运行页",
   "use": "监控页"
  },
  {
   "pattern": "harnessd|harnessctl|(?<!DeepSeek )Harness(?!Client)",
   "show": "Harness / harnessd / harnessctl",
   "use": "Anywhere Door / anydoor / anydoorctl（P.09 K194）"
  }
 ],
 "skip_files": [
  "P.06_术语表.md",
  "P.09_待决问题与已知不一致.md",
  "U.24_待修问题清单.md",
  "U.15_文案与术语.md",
  "00_从这里开始.md",
  "接力日志.md"
 ],
 "skip_line_if": [
  "不要叫",
  "改为",
  "统一为",
  "旧称",
  "不再使用",
  "已废弃",
  "取消",
  "原\"",
  "原「",
  "（原",
  "demo 里",
  "v0.5-树索引",
  "→",
  "必须统一",
  "原来的",
  "不叫"
 ]
}